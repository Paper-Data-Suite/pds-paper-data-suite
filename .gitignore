# Virtual environments
.venv/
venv/
env/

# Python cache, test, type-checking, and coverage artifacts
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python packaging/build artifacts
build/
dist/
*.egg-info/
*.whl

# Editor/IDE files
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and local scratch files
*.tmp
*.bak
*.swp
*.swo
*~

# Environment files and local secrets
.env
.env.*
!.env.example

# Paper Data Suite sensitive/generated runtime residue
# These patterns reduce accidental commits; they are not a substitute for
# keeping real classroom workspaces and backups outside the source repository.
pds-workspace-backup-*/
.pds-workspace-backup-*.incomplete-*/
.*.pds-restore.incomplete-*/
local_outputs/
scans_inbox/
classes/
*.log
